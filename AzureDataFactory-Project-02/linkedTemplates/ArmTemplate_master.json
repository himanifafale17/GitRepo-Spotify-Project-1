{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AzureDataFactory-Project-02"
		},
		"AzureDataLakeLinkedService_2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeLinkedService_2'"
		},
		"AzureSqlDBLinkedService_1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDBLinkedService_1'"
		},
		"AzureDataLakeLinkedService_2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storeaccountproject1.dfs.core.windows.net/"
		},
		"AzureSqlDBLinkedService_1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azure-project-1-server.database.windows.net"
		},
		"AzureSqlDBLinkedService_1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureDatabaseProject1"
		},
		"AzureSqlDBLinkedService_1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "leader"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AzureDataFactory-Project-02_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeLinkedService_2_accountKey": {
						"value": "[parameters('AzureDataLakeLinkedService_2_accountKey')]"
					},
					"AzureSqlDBLinkedService_1_password": {
						"value": "[parameters('AzureSqlDBLinkedService_1_password')]"
					},
					"AzureDataLakeLinkedService_2_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeLinkedService_2_properties_typeProperties_url')]"
					},
					"AzureSqlDBLinkedService_1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDBLinkedService_1_properties_typeProperties_server')]"
					},
					"AzureSqlDBLinkedService_1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDBLinkedService_1_properties_typeProperties_database')]"
					},
					"AzureSqlDBLinkedService_1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDBLinkedService_1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}