{
	"name": "Loop_Incremental_Pipeline2",
	"properties": {
		"activities": [
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.Loop_Input_Parameter",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "LastCDCLookup1_2",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"dataset": {
									"referenceName": "Json_Dynamic_Gen2_DS1",
									"type": "DatasetReference",
									"parameters": {
										"container_parameter": "bronze-container-2",
										"folder_parameter": {
											"value": "@{item().TableParameter}_cdc",
											"type": "Expression"
										},
										"file_parameter": "cdc.json"
									}
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "Set variable1_2",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "currentVariable",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						},
						{
							"name": "CopyAzureSqlLake1_2",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "LastCDCLookup1_2",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set variable1_2",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "SELECT * FROM @{item().SchemaParameter}.@{item().TableParameter} WHERE @{item().CDCcolParameter} > '@{if(empty(item().From_Date_Parameter), activity('LastCDCLookup1_2').output.firstRow.cdc, item().From_Date_Parameter)}'",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "AzureSqlDSTable_DS2",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "Parquet_dynamic_Gen2_DS3",
									"type": "DatasetReference",
									"parameters": {
										"container_parameter": "bronze-container-2",
										"folder_parameter": {
											"value": "@item().TableParameter",
											"type": "Expression"
										},
										"file_parameter": "@concat(item().TableParameter,'_',variables('currentVariable'))"
									}
								}
							]
						},
						{
							"name": "If-Incremental-Data-IfCondition1_2",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "CopyAzureSqlLake1_2",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater( activity('CopyAzureSqlLake1_2').output.dataRead, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "EmptyFileDelete1_2",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "Parquet_dynamic_Gen2_DS3",
												"type": "DatasetReference",
												"parameters": {
													"container_parameter": "bronze-container-2",
													"folder_parameter": "@item().TableParameter",
													"file_parameter": "@concat(item().TableParameter, '_', variables('currentVariable'))"
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "max_cdc_scirpt_2",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "AzureSqlDBLinkedService_1",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": "SELECT MAX (@{item().CDCcolParameter}) AS cdc FROM @{item().SchemaParameter}.@{item().TableParameter}"
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
									{
										"name": "update-lastCDC-copy2_2",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "max_cdc_scirpt_2",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "JsonSource",
												"additionalColumns": [
													{
														"name": "variable",
														"value": {
															"value": "cdc",
															"type": "Expression"
														}
													}
												],
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "JsonReadSettings"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "Json_Dynamic_Gen2_DS1",
												"type": "DatasetReference",
												"parameters": {
													"container_parameter": "bronze-container-2",
													"folder_parameter": "@{item().TableParameter}_cdc",
													"file_parameter": "cdc.json"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "Parquet_dynamic_Gen2_DS3",
												"type": "DatasetReference",
												"parameters": {
													"container_parameter": "bronze-container-2",
													"folder_parameter": "@{item().TableParameter}_cdc",
													"file_parameter": "cdc.json"
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Alert_WebActivity_1",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-20.canadacentral.logic.azure.com:443/workflows/56c8d90980fe4d6480bfaa12153dec91/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=2wDLyUUIgiv6G-AgUjrdSPw18Ol6xQ-b93VGOVNJzHc",
					"body": {
						"value": "{\n  \"pipeline_Name\": \"@{pipeline().Pipeline}\",\n  \"pipeline_runId\": \"@{pipeline().RunId}\",\n  \"status\": \"@{if(equals(activity('CopyAzureSqlLake1_2').status, 'Succeeded'), 'Succeeded', 'Failed')}\"\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"Loop_Input_Parameter": {
				"type": "string",
				"defaultValue": [
					{
						"SchemaParameter": "dbo",
						"TableParameter": "DimUser",
						"CDCcolParameter": "updated_at",
						"From_Date_Parameter": ""
					},
					{
						"SchemaParameter": "dbo",
						"TableParameter": "DimArtist",
						"CDCcolParameter": "updated_at",
						"From_Date_Parameter": ""
					},
					{
						"SchemaParameter": "dbo",
						"TableParameter": "DimDate",
						"CDCcolParameter": "Date",
						"From_Date_Parameter": ""
					},
					{
						"SchemaParameter": "dbo",
						"TableParameter": "DimTrack",
						"CDCcolParameter": "updated_at",
						"From_Date_Parameter": ""
					},
					{
						"SchemaParameter": "dbo",
						"TableParameter": "FactStream",
						"CDCcolParameter": "stream_timestamp",
						"From_Date_Parameter": ""
					}
				]
			}
		},
		"variables": {
			"currentVariable": {
				"type": "String"
			}
		},
		"annotations": []
	}
}